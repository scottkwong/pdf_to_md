# OpenRouter (Primary - supports all models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Direct Provider APIs (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_google_api_key_here
# Alternative name for Gemini API key
# GOOGLE_API_KEY=your_gemini_api_key_here

# Fireworks AI (hosted open-weight vision models, e.g. Qwen3-VL)
# Get your key from https://fireworks.ai. Then use: pdf_to_md file.pdf --fireworks
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Make a model your personal default (used when --model is not passed).
# Must be a models.json key, and you must set the matching provider key above.
# Example: route everything through Fireworks Qwen3-VL by default:
# PDF_TO_MD_MODEL=qwen3-vl-235b

# LlamaParse (Alternative extraction method)
# Get your API key from https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=your_llamacloud_api_key_here

# Local OCR (no API key needed; requires a running Ollama server)
# Install Ollama from https://ollama.com and start it, then:
#   pdf_to_md file.pdf --local
# No extra Python dependency is needed. If Ollama runs elsewhere, point at it
# with --ollama-url (default endpoint: http://localhost:11434/api/generate).
