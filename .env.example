# OpenRouter (Primary - supports all models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Direct Provider APIs (Fallback)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_google_api_key_here
# Alternative name for Gemini API key
# GOOGLE_API_KEY=your_gemini_api_key_here

# LlamaParse (Alternative extraction method)
# Get your API key from https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=your_llamacloud_api_key_here

# Local OCR via Ollama-OCR (no API key needed; requires a running Ollama server)
# Install the extra with: pip install ".[local]"
# Start Ollama from https://ollama.com, then use: pdf_to_md file.pdf --local
# Override the endpoint with --ollama-url if Ollama runs elsewhere, e.g.:
# OLLAMA default endpoint: http://localhost:11434/api/generate
